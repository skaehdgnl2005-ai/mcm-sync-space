# services/gen 환경변수 (03-mock-service-spec.md §7)
# 로컬: 이 파일을 .env로 복사해 쓰거나, 셸에서 직접 export/$env: 설정.
# Railway: 프로젝트 Variables에 동일 키로 입력.

# 필수. 인바운드 인증 키. Dev B의 GEN_API_KEY와 같은 값. 미설정 시 기동 실패.
API_KEY=dev-local-key

# 엔진 선택. mock | (실엔진 추가 시 여기 변경)
ENGINE=mock

# 성공 시나리오 지연(초). B가 로딩 연출 테스트할 때 조절.
MOCK_DELAY_SECONDS=5

# slow 시나리오 지연(초). B의 60초 클라이언트 타임아웃 검증 전용.
MOCK_SLOW_SECONDS=75

# 샘플 이미지 절대 URL 조립용. 비우면 요청의 base URL을 사용.
# Railway 도메인 확정 후 설정: https://<app>.up.railway.app
PUBLIC_BASE_URL=
