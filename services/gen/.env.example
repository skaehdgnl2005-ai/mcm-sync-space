# services/gen 환경변수 (03-mock-service-spec.md §7 · 00-common.md §10)
# 로컬: 이 파일을 .env로 복사해 쓰거나, 셸에서 직접 export/$env: 설정.
# Railway: 프로젝트 Variables에 동일 키로 입력.
# ※ 이 서비스는 .env를 자동 로딩하지 않는다. 셸 환경변수로 넣어야 한다.

# 필수. 인바운드 인증 키. Dev B의 GEN_API_KEY와 같은 값. 미설정 시 기동 실패.
API_KEY=dev-local-key

# 엔진 선택. mock | gemini_nb | gpt_image
#   mock       계약대로만 동작하는 가짜 (외부 의존 0). **롤백 목적지.**
#   gemini_nb  ★ 라이브 기본값 — gemini-3.1-flash-image (05 부록 A-17 ① · A-18 ⑦)
#   gpt_image  폴백 — gpt-image-2 (A-16 ④). 크레딧 소진용이자 gemini 장애 시 카드
ENGINE=mock

# 생성 API 키 — 선택한 ENGINE의 것만 있으면 된다.
#   ENGINE=gemini_nb → GOOGLE_API_KEY / ENGINE=gpt_image → OPENAI_API_KEY
#   ENGINE=mock이면 둘 다 불필요하다. 미설정 상태로 실엔진을 켜면 기동에서 실패한다.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# 결과 이미지 저장소. local | supabase (코드 기본값 local)
#   supabase  ★ 배포에서 쓸 값. 00-common §6 규약대로 assets 버킷 /generated/{job_id}.jpg 에
#             올린다. **영구.** 검증 완료 — public read 확인 · 왕복 I/O ≈1.6s (05 부록 A-19 ④).
#   local     이 서비스의 static/generated/ 에 쓰고 /static 으로 직접 서빙한다. 키 없이 도는 대신
#             ⚠ Railway 디스크는 **휘발성**이다 — 재배포·재시작이면 지난 결과가 사라지고
#               이미 B에게 건넨 image_url이 404가 된다. **폴백 카드로만 쓴다.**
# 기본값이 local인 것은 키 없이도 로컬 개발·mock 경로가 돌아야 하기 때문이지 권장이라는 뜻이 아니다.
STORAGE=supabase

# STORAGE=supabase일 때만 필수. 00-common §10 — B에게서 수령 완료.
# 둘 중 하나라도 비어 있으면 STORAGE=supabase는 기동에 실패한다 (조용히 local로 안 내려간다).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 성공 시나리오 지연(초). ENGINE=mock 전용. B가 로딩 연출 테스트할 때 조절.
MOCK_DELAY_SECONDS=5

# slow 시나리오 지연(초). ENGINE=mock 전용. B의 60초 클라이언트 타임아웃 검증용.
MOCK_SLOW_SECONDS=75

# 결과/샘플 이미지 절대 URL 조립용. 비우면 요청의 base URL을 사용.
# Railway 도메인 확정 후 설정: https://<app>.up.railway.app
# ※ STORAGE=local이면 이 값이 곧 B가 받는 image_url의 호스트가 된다.
PUBLIC_BASE_URL=
